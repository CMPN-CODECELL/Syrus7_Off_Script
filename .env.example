# Copy this file to .env.local and replace the placeholder values.
GEMINI_API_KEY=replace-with-your-Google-AI-Studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
APPROVAL_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MARKET_DATA_PROVIDER=demo
# Set to yahoo to enable Yahoo Finance quote and historical market data.
# This changes market data only; order execution remains on the mock broker.


